{% assign user = site.data.github.users[include.username] %}

<a class="repo-card repo-user-card" href="https://github.com/{{ include.username }}">
  {% if user.avatar_url %}
    <img class="repo-user-avatar" src="{{ user.avatar_url }}&s=128" alt="{{ include.username }}" width="64" height="64">
  {% endif %}
  <div>
    <div class="repo-card-title">
      <span>{% if user.name %}{{ user.name }}{% else %}{{ include.username }}{% endif %}</span>
    </div>
    <div class="repo-card-description">@{{ include.username }}</div>
    {% if user.public_repos %}
      <div class="repo-card-meta">
        <span>{{ user.public_repos }} repositories</span>
        <span>{{ user.followers }} followers</span>
      </div>
    {% endif %}
  </div>
</a>
